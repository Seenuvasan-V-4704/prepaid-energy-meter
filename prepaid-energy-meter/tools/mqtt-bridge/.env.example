# Copy this file to ".env" (same folder) and fill in the values.
# ".env" is ignored by git. Never commit real passwords.

# MQTT broker (EMQX): use the address and port from the deployment
# overview. Use mqtts:// with port 8883 for a secure connection.
MQTT_URL=mqtts://your-deployment.emqxsl.com:8883
MQTT_USERNAME=bridge-user
MQTT_PASSWORD=bridge-password

# The device-ingest Edge Function and its secret (INGEST_SECRET).
INGEST_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/device-ingest
INGEST_SECRET=put-the-same-secret-here
